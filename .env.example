NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=your-dataset
NEXT_PUBLIC_SANITY_API_VERSION=2026-01-01
NEXT_PUBLIC_SITE_URL=https://example.invalid
NEXT_PUBLIC_SANITY_STUDIO_URL=https://your-project.sanity.studio
SANITY_API_READ_TOKEN=your-placeholder-value
SANITY_API_WRITE_TOKEN=your-placeholder-value # Required for weather context capture on notice/record pages
MAX_STATIC_PARAMS=100 # The maximum number of static params generated for a route during build time.
NEXT_PUBLIC_GTM_ID=G-XXXXXXXXXX # Google Tag Manager ID (e.g. GTM-XXXXXXX)
INTELLIGENCE_API_KEY=your-placeholder-value # Issued to the Unami Control Centre — generate with: openssl rand -hex 32
CONTROL_CENTRE_URL=https://example.invalid # Unami Control Centre base URL (e.g. https://unami-platform-core-umkhandlu.vercel.app) — used to fetch authoritative ward boundaries. NOT the governance node URL.
NEXT_PUBLIC_CONTROL_CENTRE_URL=https://example.invalid # Same URL as CONTROL_CENTRE_URL — required for client-side map components (NoticeStatutoryMap). Must match CONTROL_CENTRE_URL.
